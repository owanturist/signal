{
  "name": "root",
  "type": "module",
  "version": "0.0.0",
  "private": true,
  "scripts": {
    "cs": "changeset",
    "version": "changeset version",
    "size": "size-limit",
    "test": "vitest",
    "test:run": "pnpm test --run --reporter=dot",
    "test:coverage": "pnpm test:run --coverage",
    "lint": "biome lint",
    "lint:fix": "biome lint --write",
    "format": "biome format",
    "format:fix": "biome format --write",
    "check": "biome check",
    "check:fix": "biome check --write",
    "typecheck": "pnpm --recursive typecheck",
    "build": "pnpm --recursive build",
    "build:minified": "pnpm build --minify"
  },
  "engines": {
    "node": ">=24.13.0"
  },
  "devEngines": {
    "packageManager": {
      "name": "pnpm",
      "version": "12.13.0",
      "onFail": "error"
    }
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/owanturist/signal.git"
  },
  "devDependencies": {
    "@biomejs/biome": "^2.5.15",
    "@changesets/changelog-github": "^0.7.0",
    "@changesets/cli": "^2.31.0",
    "@size-limit/preset-small-lib": "^12.1.0",
    "@types/node": "^26.6.5",
    "@vitest/coverage-v8": "^5.0.3",
    "size-limit": "^12.1.0",
    "terser": "^5.51.2",
    "tsdown": "^0.23.0",
    "typescript": "^7.0.2",
    "vitest": "^5.0.3"
  }
}
