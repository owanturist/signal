{
  "name": "root",
  "type": "module",
  "version": "0.0.0",
  "private": true,
  "scripts": {
    "cs": "changeset",
    "version": "changeset version",
    "size": "size-limit",
    "test": "vitest",
    "test:run": "pnpm test --run --reporter=dot",
    "test:coverage": "pnpm test:run --coverage",
    "lint": "biome lint",
    "lint:fix": "biome lint --write",
    "format": "biome format",
    "format:fix": "biome format --write",
    "check": "biome check",
    "check:fix": "biome check --write",
    "typecheck": "nx run-many -t typecheck",
    "build": "nx run-many -t build",
    "build:minified": "pnpm build --minify"
  },
  "engines": {
    "node": ">=24.13.0"
  },
  "devEngines": {
    "packageManager": {
      "name": "pnpm",
      "version": "12.13.0",
      "onFail": "error"
    }
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/owanturist/signal.git"
  },
  "devDependencies": {
    "@biomejs/biome": "^2.5.15",
    "@changesets/changelog-github": "^1.0.1",
    "@changesets/cli": "^3.0.3",
    "@size-limit/preset-small-lib": "^14.2.0",
    "@types/node": "^26.6.5",
    "@vitest/coverage-v8": "catalog:",
    "nx": "^23.3.0",
    "size-limit": "^14.2.0",
    "terser": "^5.51.2",
    "tsdown": "^0.23.1",
    "typescript": "^7.0.2",
    "vite": "catalog:",
    "vitest": "catalog:"
  }
}
