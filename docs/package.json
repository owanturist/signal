{
  "name": "docs",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "preview": "vite preview",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "@codesandbox/sandpack-react": "^2.20.0",
    "@owanturist/signal": "workspace:*",
    "@owanturist/signal-react": "workspace:*",
    "@tanstack/react-router": "^1.170.45",
    "@tanstack/react-start": "^1.169.3",
    "clsx": "^2.1.1",
    "fumadocs-core": "^16.17.7",
    "fumadocs-mdx": "15.4.8",
    "fumadocs-ui": "^16.17.7",
    "lucide-react": "^1.59.0",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "react-resizable-panels": "^4.14.6"
  },
  "devDependencies": {
    "@tailwindcss/vite": "^4.3.3",
    "@tanstack/router-plugin": "^1.168.47",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.1.2",
    "tailwindcss": "^4.3.3",
    "vite": "^8.3.4"
  },
  "nx": {
    "targets": {
      "build": {
        "inputs": [
          "production",
          "^production",
          "{workspaceRoot}/tsconfig.json",
          "{workspaceRoot}/tsconfig.build.json",
          "{workspaceRoot}/tsdown.config.mjs",
          {
            "env": "DOCS_BASE"
          }
        ]
      }
    }
  }
}
